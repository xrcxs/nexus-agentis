# NEXUS//AGENTIS Environment Configuration
# Copy to .env and populate with your free-tier Groq and Tavily API keys.
# Secrets are loaded strictly on the backend and never logged or exposed to the browser.

GROQ_API_KEY=gsk_your_groq_api_key_here
TAVILY_API_KEY=tvly-your_tavily_api_key_here
NEXUS_LEDGER_SECRET=replace-with-32-byte-random-hmac-sha256-secret

# Optional runtime tuning
GROQ_MODEL=llama-3.3-70b-versatile
DEFAULT_TOKEN_BUDGET=32000
MAX_TOKEN_BUDGET=128000
DEFAULT_MAX_LOOPS=3
DEFAULT_SUPPORT_THRESHOLD=0.75
MIN_CREDIBLE_SOURCES=2
CREDIBILITY_THRESHOLD=0.60
RUN_TIMEOUT_SECONDS=180.0
MAX_CONCURRENT_RUNS=4
MAX_REQUEST_BYTES=32768
RATE_LIMIT_RPM=30
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8080

# Set NEXUS_STUB_APIS=true ONLY for offline local smoke testing / CI without API keys
NEXUS_STUB_APIS=false
